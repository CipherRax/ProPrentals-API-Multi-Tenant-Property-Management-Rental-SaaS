# ── Application ─────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001
API_PREFIX=api/v1

# ── Database ────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/proprentals?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/proprentals?schema=public"

# ── Redis / BullMQ ──────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── JWT ─────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── M-Pesa (Daraja) ─────────────────────────────────────────
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-domain.com/api/v1/mpesa/callback

# ── Email (SMTP) ────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Habita <no-reply@habita.app>"

# ── SMS (Africa's Talking) ──────────────────────────────────
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=

# ── Storage ─────────────────────────────────────────────────
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ── Rate limiting ───────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=20
