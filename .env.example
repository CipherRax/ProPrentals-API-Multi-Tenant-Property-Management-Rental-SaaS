# ── Application ─────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001
API_PREFIX=api/v1

# ── Database ────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/proprentals?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/proprentals?schema=public"

# ── Redis / BullMQ ──────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── JWT ─────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── M-Pesa (Daraja) ─────────────────────────────────────────
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-domain.com/api/v1/mpesa/callback
# Optional shared secret checked against x-mpesa-callback-key on inbound
# callbacks. Leave empty for standard Safaricom callbacks (which do not
# send this header); setting it disables unauthenticated callbacks.
MPESA_CALLBACK_KEY=

# ── Email (SMTP) ────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Habita <no-reply@habita.app>"

# ── SMS (Africa's Talking) ──────────────────────────────────
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=

# ── Storage ─────────────────────────────────────────────────
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ── AI features ─────────────────────────────────────────────
# AI_PROVIDER=heuristic uses deterministic, number-grounded insight/search
# generation with no external dependency. Set AI_PROVIDER=openai plus a key
# to route dashboard insights + natural-language marketplace search through
# an LLM. A basic tier is fine (the features are intentionally cheap).
AI_PROVIDER=heuristic
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ── Rate limiting ───────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=20
