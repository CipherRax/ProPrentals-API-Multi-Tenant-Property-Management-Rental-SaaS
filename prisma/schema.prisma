// Membership is the join between a User and an Organization,
// carrying the org-scoped role. This is what RBAC guards check —
// never trust an organizationId supplied by the client; derive
// it from the authenticated user's membership record.
model OrganizationMember {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           OrgRole
  isActive       Boolean  @default(true)
  invitedAt      DateTime?
  joinedAt       DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, userId])
  @@index([organizationId, role])
  @@map("organization_members")
}

model StaffInvitation {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           OrgRole
  tokenHash      String   @unique
  status         String   @default("PENDING") // PENDING | ACCEPTED | EXPIRED | REVOKED
  invitedByUserId String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime @default(now())

  @@index([organizationId, status])
  @@map("staff_invitations")
}

// ─────────────────────────────────────────────────────────────
// AUDIT LOG  (append-only; never update/delete from app code)
// ─────────────────────────────────────────────────────────────

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actorUserId    String?
  actor          User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action         String
  entityType     String
  entityId       String?
  previousValue  Json?
  newValue       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────
// PHASE 2 — PROPERTIES / BUILDINGS / UNITS
// ─────────────────────────────────────────────────────────────

enum PropertyType {
  APARTMENT_COMPLEX
  RESIDENTIAL_BUILDING
  HOUSE
  COMMERCIAL
  MIXED_USE
  STUDENT_HOUSING
  OTHER
}

enum PropertyStatus {
  ACTIVE
  INACTIVE
  UNDER_CONSTRUCTION
  ARCHIVED
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum UnitType {
  APARTMENT
  BEDSITTER
  SINGLE_ROOM
  ONE_BEDROOM
  TWO_BEDROOM
  THREE_BEDROOM
  MAISONETTE
  HOUSE
  SHOP
  OFFICE
  PARKING_SPACE
  OTHER
}

// Deliberately distinct from occupancy: a unit's occupancy is derived
// from its Tenancy records (Phase 3+), never hand-set here. This field
// only tracks operational/public-listing readiness.
enum UnitAvailabilityStatus {
  VACANT
  AVAILABLE
  RESERVED
  OCCUPIED
  MAINTENANCE
  UNAVAILABLE
}

model Property {
  id                 String             @id @default(uuid())
  organizationId     String
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name               String
  propertyType       PropertyType       @default(OTHER)
  description        String?

  addressLine        String?
  county             String?
  city               String?
  neighborhood       String?
  latitude           Float?
  longitude          Float?
  postalAddress      String?

  contactPhone       String?
  contactEmail       String?
  amenities          String[]           @default([])

  status             PropertyStatus     @default(ACTIVE)
  isPubliclyListable Boolean            @default(false) // owner intent; actual public visibility resolved in Phase 21 listings
  verificationStatus VerificationStatus @default(UNVERIFIED)

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?

  buildings          Building[]
  units              Unit[]
  images             PropertyImage[]
  tenantInvitations  TenantInvitation[]

  @@index([organizationId, status])
  @@index([county, city])
  @@map("properties")
}

model PropertyImage {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  url        String
  caption    String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([propertyId])
  @@map("property_images")
}

model Building {
  id             String   @id @default(uuid())
  propertyId     String
  property       Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  name           String
  buildingNumber String?
  description    String?
  floors         Int?
  amenities      String[] @default([])

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  units          Unit[]

  @@index([propertyId])
  @@map("buildings")
}

model Unit {
  id                 String                  @id @default(uuid())
  propertyId         String
  property           Property                @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  buildingId         String?
  building           Building?               @relation(fields: [buildingId], references: [id], onDelete: SetNull)

  unitNumber         String
  unitType           UnitType                @default(OTHER)
  floor              String?
  bedrooms           Int?
  bathrooms          Int?
  sizeSqm            Decimal?                @db.Decimal(10, 2)

  baseRent           Decimal                 @db.Decimal(12, 2)
  depositAmount      Decimal                 @db.Decimal(12, 2)

  description        String?
  amenities          String[]                @default([])

  availabilityStatus UnitAvailabilityStatus  @default(VACANT)
  isPubliclyListable Boolean                 @default(false)

  createdAt          DateTime                @default(now())
  updatedAt           DateTime               @updatedAt
  deletedAt           DateTime?

  images             UnitImage[]

  tenancies          Tenancy[]
  invitations        TenantInvitation[]
  rentCharges        RentCharge[]

  @@unique([propertyId, unitNumber])
  @@index([propertyId, availabilityStatus])
  @@index([buildingId])
  @@map("units")
}

model UnitImage {
  id        String   @id @default(uuid())
  unitId    String
  unit      Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  url       String
  caption   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([unitId])
  @@map("unit_images")
}

// ─────────────────────────────────────────────────────────────
// PHASE 3 — TENANTS / INVITATIONS / TENANCIES
// ─────────────────────────────────────────────────────────────

enum TenantProfileStatus {
  INVITED
  ACTIVE
  INACTIVE
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum BillingFrequency {
  MONTHLY
  QUARTERLY
  ANNUALLY
}

enum TenancyStatus {
  PENDING
  ACTIVE
  EXPIRED
  TERMINATED
  CANCELLED
}

// A tenant's identity within THIS organization. Deliberately org-scoped
// rather than global: the same physical person renting from two
// unrelated landlords on the platform gets two TenantProfile rows (each
// landlord's org must never see the other's tenant data), even though
// both may eventually point at the same underlying User if they choose
// to log in with the same email.
model TenantProfile {
  id             String              @id @default(uuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?               @relation(fields: [userId], references: [id], onDelete: SetNull)

  fullName             String
  email                String
  phone                String?
  profileImageUrl      String?
  idNumber             String?
  emergencyContactName String?
  emergencyContactPhone String?
  addressLine          String?

  status         TenantProfileStatus @default(INVITED)

  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  deletedAt      DateTime?

  tenancies      Tenancy[]

  @@unique([organizationId, userId])
  @@index([organizationId, status])
  @@index([organizationId, email])
  @@map("tenant_profiles")
}

// Secure, single-use, expiring invitation token (spec §11). Only the
// SHA-256 hash of the token is stored — the raw token is returned once,
// at creation time, and never persisted or logged in plaintext.
model TenantInvitation {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyId     String
  property       Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unitId         String
  unit           Unit             @relation(fields: [unitId], references: [id], onDelete: Cascade)

  tenantFullName String
  email          String
  phone          String?

  proposedRentAmount    Decimal   @db.Decimal(12, 2)
  proposedDepositAmount Decimal   @db.Decimal(12, 2)
  proposedStartDate     DateTime?
  billingFrequency      BillingFrequency @default(MONTHLY)
  paymentDueDay         Int       @default(5)

  tokenHash      String           @unique
  status         InvitationStatus @default(PENDING)
  invitedByUserId String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime         @default(now())

  @@index([organizationId, status])
  @@index([unitId, status])
  @@map("tenant_invitations")
}

