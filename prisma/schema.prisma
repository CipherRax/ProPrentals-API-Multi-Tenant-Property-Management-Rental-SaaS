// ─────────────────────────────────────────────────────────────
// PHASE 6 — PAYMENTS (incl. M-PESA)
// ─────────────────────────────────────────────────────────────

enum PaymentMethod {
  MPESA
  CASH
  BANK_TRANSFER
  OTHER
}

// Initiating a payment is never the same as it having succeeded (spec
// §17). MPESA payments start at INITIATED/PENDING and only become
// SUCCESSFUL/FAILED via the Daraja callback — never based on client
// input. Manual payments are recorded already-SUCCESSFUL, since by
// definition the landlord is logging money already received.
enum PaymentStatus {
  INITIATED
  PENDING
  SUCCESSFUL
  FAILED
  CANCELLED
  REVERSED
  REFUNDED
}

model Payment {
  id             String        @id @default(uuid())
  organizationId String
  tenancyId      String
  tenancy        Tenancy       @relation(fields: [tenancyId], references: [id], onDelete: Cascade)

  amount   Decimal       @db.Decimal(12, 2)
  currency String        @default("KES")
  method   PaymentMethod
  status   PaymentStatus @default(INITIATED)

  // M-Pesa-specific. providerCheckoutId is Daraja's CheckoutRequestID,
  // set at STK Push initiation and used to match the eventual callback
  // to this row. providerTransactionId is the M-Pesa receipt number,
  // set only once the payment is confirmed successful — this is the
  // real, globally-unique idempotency key a duplicate Safaricom callback
  // gets checked against (spec's own learning: prefer a DB unique
  // constraint on the provider receipt over an app-layer check).
  providerCheckoutId    String? @unique
  providerTransactionId String? @unique
  phoneNumber           String?
  rawCallbackPayload    Json?
  failureReason         String?

  // Manual-payment-specific. Deliberately NOT unique — two different
  // landlords' bank references or cheque numbers can coincidentally
  // collide without meaning anything, unlike an M-Pesa receipt number.
  manualReference String?
  notes           String?

  initiatedByUserId String?
  recordedByUserId  String?

  initiatedAt DateTime  @default(now())
  confirmedAt DateTime?
  failedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  allocations   PaymentAllocation[]
  ledgerEntries LedgerEntry[]
  receipt       Receipt?

  @@index([organizationId, status])
  @@index([tenancyId, status])
  @@map("payments")
}

// Records which rent charge(s) a payment was applied against, oldest
// due date first. This is what lets RentCharge.status become PAID/
// PARTIALLY_PAID based on real money received, rather than a hand-set
// value (spec §16, §73) — see RentChargesService/PaymentsService.
model PaymentAllocation {
  id          String     @id @default(uuid())
  paymentId   String
  payment     Payment    @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  rentChargeId String
  rentCharge  RentCharge @relation(fields: [rentChargeId], references: [id], onDelete: Cascade)
  amount      Decimal    @db.Decimal(12, 2)
  createdAt   DateTime   @default(now())

  @@unique([paymentId, rentChargeId])
  @@index([rentChargeId])
  @@map("payment_allocations")
}

// ─────────────────────────────────────────────────────────────
// PHASE 7 — RECEIPTS & TENANT STATEMENTS
// ─────────────────────────────────────────────────────────────

// One receipt per successful payment (spec §20). receiptNumber is
// generated from Organization.receiptSequence via an atomic increment
// in the same transaction that creates the receipt — this is the real
// uniqueness guarantee (backed by the @unique below), not just careful
// application code. PDFs are generated on demand from this data rather
// than stored as files, since the file-storage abstraction (spec §45)
// isn't built yet — see README.
model Receipt {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tenancyId      String
  tenancy        Tenancy  @relation(fields: [tenancyId], references: [id], onDelete: Cascade)
  paymentId      String   @unique
  payment        Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  receiptNumber String  @unique
  amount        Decimal @db.Decimal(12, 2)
  issuedAt      DateTime @default(now())

  createdAt DateTime @default(now())

  @@index([organizationId, issuedAt])
