// Every category of financial event that can touch a tenant's balance.
// PAYMENT is defined here but not yet posted by anything — the Payments
// module (next phase) posts it once a Payment model exists to reference.
enum LedgerEntryType {
  RENT_CHARGE
  PAYMENT
  REFUND
  LATE_FEE
  CREDIT_ADJUSTMENT
  DEBIT_ADJUSTMENT
  WAIVER
}

enum LedgerEntryDirection {
  DEBIT // increases what the tenant owes
  CREDIT // decreases what the tenant owes
}

// Append-only. There is deliberately no update/delete path anywhere in
// the app for this model (spec §15, §38, §73) — correcting a mistake
// means posting a reversing entry that references the original, never
// editing history. A tenant's balance is always SUM(DEBIT) - SUM(CREDIT)
// over these rows, computed on read, never cached in a mutable column.
model LedgerEntry {
  id             String               @id @default(uuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tenancyId      String
  tenancy        Tenancy              @relation(fields: [tenancyId], references: [id], onDelete: Cascade)

  entryType   LedgerEntryType
  direction   LedgerEntryDirection
  amount      Decimal              @db.Decimal(12, 2)
  description String?

  relatedRentChargeId String?
  relatedRentCharge   RentCharge?  @relation(fields: [relatedRentChargeId], references: [id], onDelete: SetNull)

