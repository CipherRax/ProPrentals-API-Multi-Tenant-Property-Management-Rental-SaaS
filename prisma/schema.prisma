// ─────────────────────────────────────────────────────────────
// PHASE 4 — RENT CONFIGURATION / RENT GENERATION
// ─────────────────────────────────────────────────────────────

// Charge status is intentionally minimal for now. PAID/PARTIALLY_PAID/
// OVERPAID will become properly *derived* from the Ledger (next phase)
// rather than stored directly — see README. Only UNPAID → OVERDUE (cron)
// and UNPAID/OVERDUE → WAIVED (manual, by an authorized user) are
// actually driven from this phase.
enum RentChargeStatus {
  UNPAID
  OVERDUE
  PARTIALLY_PAID
  PAID
  WAIVED
  CANCELLED
}

// Historically-traceable rent pricing (spec §13): rent changes never
// overwrite the prior amount — closing the old row's effectiveTo and
// inserting a new one is the only way rent ever changes. Exactly one row
// per tenancy should have effectiveTo = null (the current terms) at any
// given time; enforced in RentConfigurationsService, not at the DB level.
model RentConfiguration {
  id             String    @id @default(uuid())
  tenancyId      String
  tenancy        Tenancy   @relation(fields: [tenancyId], references: [id], onDelete: Cascade)
  organizationId String
  unitId         String

  amount              Decimal          @db.Decimal(12, 2)
  billingFrequency    BillingFrequency @default(MONTHLY)
  paymentDueDay       Int              @default(5)
  gracePeriodDays     Int              @default(0)
  lateFeeAmount       Decimal?         @db.Decimal(12, 2)
  lateFeeIsPercentage Boolean          @default(false)

  effectiveFrom DateTime
  effectiveTo   DateTime?
  notes         String?

  createdByUserId String?
  createdAt       DateTime @default(now())

  rentCharges RentCharge[]

  @@index([tenancyId, effectiveFrom])
  @@index([organizationId])
  @@map("rent_configurations")
}

