generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                      String                   @id @default(uuid())
  email                   String                   @unique
  phone                   String?                  @unique
  passwordHash            String
  firstName               String
  lastName                String
  avatarUrl               String?
  status                  UserStatus               @default(PENDING_VERIFICATION)
  emailVerifiedAt         DateTime?
  phoneVerifiedAt         DateTime?
  platformRole            PlatformRole?
  failedLoginCount        Int                      @default(0)
  lockedUntil             DateTime?
  lastLoginAt             DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  deletedAt               DateTime?
  auditLogs               AuditLog[]
  conversationsAsTenant   Conversation[]
  emailVerifications      EmailVerificationToken[]
  maintenanceRequests     MaintenanceRequest[]
  announcementsRead       AnnouncementReadState[]
  notificationPreferences NotificationPreference[]
  memberships             OrganizationMember[]
  passwordResets          PasswordResetToken[]
  refreshTokens           RefreshToken[]
  tenantProfile           TenantProfile[]
  announcements           Announcement[]
  assignedMaintenance     MaintenanceRequest[] @relation("MaintenanceAssignee")

  @@index([status])
  @@map("users")
}

model RefreshToken {
  id         String   @id @default(uuid())
  userId     String
  tokenHash  String   @unique
  revoked    Boolean  @default(false)
  replacedBy String?
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model Organization {
  id                  String               @id @default(uuid())
  name                String
  slug                String               @unique
  description         String?
  logoUrl             String?
  contactEmail        String?
  contactPhone        String?
  addressLine         String?
  country             String               @default("KE")
  currency            String               @default("KES")
  timezone            String               @default("Africa/Nairobi")
  subscriptionPlan    SubscriptionPlanTier @default(FREE)
  subscriptionStatus  SubscriptionStatus   @default(TRIAL)
  onboardingStep      String               @default("ORGANIZATION_CREATED")
  onboardingCompleted Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?
  receiptSequence     Int                  @default(0)
  auditLogs           AuditLog[]
  announcements       Announcement[]
  conversations       Conversation[]
  inquiries           PropertyInquiry[]
  ledgerEntries       LedgerEntry[]
  maintenanceRequests MaintenanceRequest[]
  members             OrganizationMember[]
  properties          Property[]
  receipts            Receipt[]
  securityDeposits    SecurityDeposit[]
  invitations         StaffInvitation[]
  subscriptions      Subscription?
  subscriptionPayments SubscriptionPayment[]
  tenancies           Tenancy[]
  tenantInvitations   TenantInvitation[]
  tenantProfiles      TenantProfile[]

  @@index([subscriptionStatus])
  @@map("organizations")
}

model OrganizationMember {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  role           OrgRole
  isActive       Boolean      @default(true)
  invitedAt      DateTime?
  joinedAt       DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId, role])
  @@map("organization_members")
}

model StaffInvitation {
  id              String       @id @default(uuid())
  organizationId  String
  email           String
  role            OrgRole
  tokenHash       String       @unique
  status          String       @default("PENDING")
  invitedByUserId String?
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime     @default(now())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@map("staff_invitations")
}

model AuditLog {
  id             String        @id @default(uuid())
  organizationId String?
  actorUserId    String?
  action         String
  entityType     String
  entityId       String?
  previousValue  Json?
  newValue       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime      @default(now())
  actor          User?         @relation(fields: [actorUserId], references: [id])
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model Property {
  id                 String             @id @default(uuid())
  organizationId     String
  name               String
  propertyType       PropertyType       @default(OTHER)
  description        String?
  addressLine        String?
  county             String?
  city               String?
  neighborhood       String?
  latitude           Float?
  longitude          Float?
  postalAddress      String?
  contactPhone       String?
  contactEmail       String?
  amenities          String[]           @default([])
  status             PropertyStatus     @default(ACTIVE)
  isPubliclyListable Boolean            @default(false)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?
  buildings          Building[]
  inquiries          PropertyInquiry[]
  maintenanceRequests MaintenanceRequest[]
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  images             PropertyImage[]
  tenantInvitations  TenantInvitation[]
  units              Unit[]
  announcements      Announcement[]

  @@index([organizationId, status])
  @@index([county, city])
  @@map("properties")
}

model PropertyImage {
  id         String   @id @default(uuid())
  propertyId String
  url        String
  caption    String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("property_images")
}

model Building {
  id             String    @id @default(uuid())
  propertyId     String
  name           String
  buildingNumber String?
  description    String?
  floors         Int?
  amenities      String[]  @default([])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  property       Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  units          Unit[]
  announcements  Announcement[]

  @@index([propertyId])
  @@map("buildings")
}

model Unit {
  id                 String                 @id @default(uuid())
  propertyId         String
  buildingId         String?
  unitNumber         String
  unitType           UnitType               @default(OTHER)
  floor              String?
  bedrooms           Int?
  bathrooms          Int?
  sizeSqm            Decimal?               @db.Decimal(10, 2)
  baseRent           Decimal                @db.Decimal(12, 2)
  depositAmount      Decimal                @db.Decimal(12, 2)
  description        String?
  amenities          String[]               @default([])
  availabilityStatus UnitAvailabilityStatus @default(VACANT)
  isPubliclyListable Boolean                @default(false)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  deletedAt          DateTime?
  rentCharges        RentCharge[]
  tenancies          Tenancy[]
  invitations        TenantInvitation[]
  images             UnitImage[]
  maintenanceRequests MaintenanceRequest[]
  inquiries          PropertyInquiry[]
  building           Building?              @relation(fields: [buildingId], references: [id])
  property           Property               @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, unitNumber])
  @@index([propertyId, availabilityStatus])
  @@index([buildingId])
  @@map("units")
}

model UnitImage {
  id        String   @id @default(uuid())
  unitId    String
  url       String
  caption   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  unit      Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([unitId])
  @@map("unit_images")
}

model Announcement {
  id              String              @id @default(uuid())
  organizationId  String
  title           String
  message         String
  audience        AnnouncementAudience@default(ALL_TENANTS)
  createdByUserId String?
  propertyId      String?
  buildingId      String?
  unitIds         String[]            @default([])
  tenantProfileIds String[]           @default([])
  scheduledAt     DateTime?
  publishedAt     DateTime?
  expiresAt       DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy       User?               @relation(fields: [createdByUserId], references: [id])
  property        Property?           @relation(fields: [propertyId], references: [id])
  building        Building?           @relation(fields: [buildingId], references: [id])
  readStates      AnnouncementReadState[]

  @@index([organizationId, publishedAt])
  @@index([organizationId, createdAt])
  @@map("announcements")
}

model AnnouncementReadState {
  id             String       @id @default(uuid())
  announcementId String
  userId         String
  readAt         DateTime     @default(now())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@map("announcement_read_states")
}

model MaintenanceRequest {
  id                String               @id @default(uuid())
  organizationId    String
  propertyId        String
  unitId            String
  tenantUserId      String?
  title             String
  description       String
  category          MaintenanceCategory
  priority          MaintenancePriority  @default(MEDIUM)
  status            MaintenanceStatus    @default(OPEN)
  assignedToUserId  String?
  resolution        String?
  resolvedAt        DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  attachments       MaintenanceAttachment[]
  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property          Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit              Unit                 @relation(fields: [unitId], references: [id], onDelete: Cascade)
  tenant            User?                @relation(fields: [tenantUserId], references: [id])
  assignedTo        User?                @relation("MaintenanceAssignee", fields: [assignedToUserId], references: [id])

  @@index([organizationId, status])
  @@index([organizationId, propertyId, status])
  @@index([unitId])
  @@index([tenantUserId, status])
  @@map("maintenance_requests")
}

model MaintenanceAttachment {
  id        String             @id @default(uuid())
  requestId String
  url       String
  caption   String?
  createdAt DateTime           @default(now())
  request   MaintenanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("maintenance_attachments")
}

model PropertyInquiry {
  id             String         @id @default(uuid())
  organizationId String
  propertyId     String?
  unitId         String?
  name           String
  email          String
  phone          String?
  message        String
  status         InquiryStatus  @default(NEW)
  respondedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property       Property?      @relation(fields: [propertyId], references: [id])
  unit           Unit?          @relation(fields: [unitId], references: [id])

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([propertyId])
  @@map("property_inquiries")
}

model SubscriptionPlan {
  id                 String               @id @default(uuid())
  tier               SubscriptionPlanTier @unique
  name               String
  description        String?
  priceMonthly       Decimal              @db.Decimal(12, 2)
  priceAnnual        Decimal?             @db.Decimal(12, 2)
  maxProperties      Int?
  maxUnits           Int?
  maxTenants         Int?
  maxStaff           Int?
  storageLimitBytes  BigInt?
  features           String[]             @default([])
  mpesaEnabled       Boolean              @default(false)
  smsEnabled         Boolean              @default(false)
  reportsEnabled     Boolean              @default(false)
  maintenanceEnabled Boolean              @default(false)
  marketplaceEnabled Boolean              @default(false)
  advancedAnalytics  Boolean              @default(false)
  isActive           Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  subscriptions      Subscription[]
  paymentHistory     SubscriptionPayment[]

  @@map("subscription_plans")
}

model Subscription {
  id                String               @id @default(uuid())
  organizationId    String               @unique
  planId            String?
  tier              SubscriptionPlanTier @default(FREE)
  status            SubscriptionStatus   @default(TRIAL)
  startDate         DateTime?
  trialEndsAt       DateTime?
  nextBillingDate   DateTime?
  renewalDate       DateTime?
  gracePeriodEndsAt DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan              SubscriptionPlan?    @relation(fields: [planId], references: [id])
  payments          SubscriptionPayment[]

  @@index([status])
  @@index([tier])
  @@map("subscriptions")
}

model SubscriptionPayment {
  id                    String          @id @default(uuid())
  organizationId        String
  subscriptionId        String?
  planId                String
  tier                  SubscriptionPlanTier
  amount                Decimal         @db.Decimal(12, 2)
  currency              String          @default("KES")
  status                PaymentStatus   @default(PENDING)
  provider              String?
  providerCheckoutId    String?         @unique
  providerTransactionId String?         @unique
  manualReference       String?
  notes                 String?
  periodStart           DateTime?
  periodEnd             DateTime?
  paidAt                DateTime?
  failureReason         String?
  initiatedByUserId     String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  organization          Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription          Subscription?   @relation(fields: [subscriptionId], references: [id])
  plan                  SubscriptionPlan? @relation(fields: [planId], references: [id])

  @@index([organizationId, status])
  @@index([tier, paidAt])
  @@map("subscription_payments")
}

model TenantProfile {
  id                    String              @id @default(uuid())
  organizationId        String
  userId                String?
  fullName              String
  email                 String
  phone                 String?
  profileImageUrl       String?
  idNumber              String?
  emergencyContactName  String?
  emergencyContactPhone String?
  addressLine           String?
  status                TenantProfileStatus @default(INVITED)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  deletedAt             DateTime?
  tenancies             Tenancy[]
  organization          Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                  User?               @relation(fields: [userId], references: [id])

  @@unique([organizationId, userId])
  @@index([organizationId, status])
  @@index([organizationId, email])
  @@map("tenant_profiles")
}

model TenantInvitation {
  id                    String           @id @default(uuid())
  organizationId        String
  propertyId            String
  unitId                String
  tenantFullName        String
  email                 String
  phone                 String?
  proposedRentAmount    Decimal          @db.Decimal(12, 2)
  proposedDepositAmount Decimal          @db.Decimal(12, 2)
  proposedStartDate     DateTime?
  billingFrequency      BillingFrequency @default(MONTHLY)
  paymentDueDay         Int              @default(5)
  tokenHash             String           @unique
  status                InvitationStatus @default(PENDING)
  invitedByUserId       String?
  expiresAt             DateTime
  acceptedAt            DateTime?
  revokedAt             DateTime?
  createdAt             DateTime         @default(now())
  organization          Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property              Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit                  Unit             @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([unitId, status])
  @@map("tenant_invitations")
}

model Tenancy {
  id                 String              @id @default(uuid())
  organizationId     String
  unitId             String
  tenantProfileId    String
  startDate          DateTime
  expectedEndDate    DateTime?
  endDate            DateTime?
  rentAmount         Decimal             @db.Decimal(12, 2)
  depositAmount      Decimal             @db.Decimal(12, 2)
  paymentDueDay      Int                 @default(5)
  billingFrequency   BillingFrequency    @default(MONTHLY)
  status             TenancyStatus       @default(PENDING)
  agreementUrl       String?
  notes              String?
  terminationDate    DateTime?
  terminationReason  String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  ledgerEntries      LedgerEntry[]
  payments           Payment[]
  receipts           Receipt[]
  rentCharges        RentCharge[]
  rentConfigurations RentConfiguration[]
  securityDeposit    SecurityDeposit?
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tenantProfile      TenantProfile       @relation(fields: [tenantProfileId], references: [id], onDelete: Cascade)
  unit               Unit                @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([unitId, status])
  @@index([tenantProfileId])
  @@map("tenancies")
}

model RentConfiguration {
  id                  String           @id @default(uuid())
  tenancyId           String
  organizationId      String
  unitId              String
  amount              Decimal          @db.Decimal(12, 2)
  billingFrequency    BillingFrequency @default(MONTHLY)
  paymentDueDay       Int              @default(5)
  gracePeriodDays     Int              @default(0)
  lateFeeAmount       Decimal?         @db.Decimal(12, 2)
  lateFeeIsPercentage Boolean          @default(false)
  effectiveFrom       DateTime
  effectiveTo         DateTime?
  notes               String?
  createdByUserId     String?
  createdAt           DateTime         @default(now())
  rentCharges         RentCharge[]
  tenancy             Tenancy          @relation(fields: [tenancyId], references: [id], onDelete: Cascade)

  @@index([tenancyId, effectiveFrom])
  @@index([organizationId])
  @@map("rent_configurations")
}

model RentCharge {
  id                  String              @id @default(uuid())
  organizationId      String
  tenancyId           String
  unitId              String
  rentConfigurationId String
  billingPeriodStart  DateTime
  billingPeriodEnd    DateTime
  amount              Decimal             @db.Decimal(12, 2)
  amountPaid          Decimal             @default(0) @db.Decimal(12, 2)
  dueDate             DateTime
  status              RentChargeStatus    @default(UNPAID)
  waivedReason        String?
  waivedByUserId      String?
  waivedAt            DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  ledgerEntries       LedgerEntry[]
  paymentAllocations  PaymentAllocation[]
  rentConfiguration   RentConfiguration   @relation(fields: [rentConfigurationId], references: [id])
  tenancy             Tenancy             @relation(fields: [tenancyId], references: [id], onDelete: Cascade)
  unit                Unit                @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([tenancyId, billingPeriodStart])
  @@index([organizationId, status])
  @@index([unitId])
  @@index([status, dueDate])
  @@map("rent_charges")
}

model LedgerEntry {
  id                  String               @id @default(uuid())
  organizationId      String
  tenancyId           String
  entryType           LedgerEntryType
  direction           LedgerEntryDirection
  amount              Decimal              @db.Decimal(12, 2)
  description         String?
  relatedRentChargeId String?
  relatedPaymentId    String?
  reversesEntryId     String?              @unique
  createdByUserId     String?
  createdAt           DateTime             @default(now())
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  relatedPayment      Payment?             @relation(fields: [relatedPaymentId], references: [id])
  relatedRentCharge   RentCharge?          @relation(fields: [relatedRentChargeId], references: [id])
  reversesEntry       LedgerEntry?         @relation("LedgerReversal", fields: [reversesEntryId], references: [id])
  reversedBy          LedgerEntry?         @relation("LedgerReversal")
  tenancy             Tenancy              @relation(fields: [tenancyId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([tenancyId, createdAt])
  @@index([relatedRentChargeId])
  @@index([relatedPaymentId])
  @@map("ledger_entries")
}

model Payment {
  id                    String              @id @default(uuid())
  organizationId        String
  tenancyId             String
  amount                Decimal             @db.Decimal(12, 2)
  currency              String              @default("KES")
  method                PaymentMethod
  status                PaymentStatus       @default(INITIATED)
  providerCheckoutId    String?             @unique
  providerTransactionId String?             @unique
  phoneNumber           String?
  rawCallbackPayload    Json?
  failureReason         String?
  manualReference       String?
  notes                 String?
  initiatedByUserId     String?
  recordedByUserId      String?
  initiatedAt           DateTime            @default(now())
  confirmedAt           DateTime?
  failedAt              DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  ledgerEntries         LedgerEntry[]
  allocations           PaymentAllocation[]
  tenancy               Tenancy             @relation(fields: [tenancyId], references: [id], onDelete: Cascade)
  receipt               Receipt?

  @@index([organizationId, status])
  @@index([tenancyId, status])
  @@map("payments")
}

model PaymentAllocation {
  id           String     @id @default(uuid())
  paymentId    String
  rentChargeId String
  amount       Decimal    @db.Decimal(12, 2)
  createdAt    DateTime   @default(now())
  payment      Payment    @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  rentCharge   RentCharge @relation(fields: [rentChargeId], references: [id], onDelete: Cascade)

  @@unique([paymentId, rentChargeId])
  @@index([rentChargeId])
  @@map("payment_allocations")
}

model Receipt {
  id             String       @id @default(uuid())
  organizationId String
  tenancyId      String
  paymentId      String       @unique
  receiptNumber  String       @unique
  amount         Decimal      @db.Decimal(12, 2)
  issuedAt       DateTime     @default(now())
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payment        Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  tenancy        Tenancy      @relation(fields: [tenancyId], references: [id], onDelete: Cascade)

  @@index([organizationId, issuedAt])
  @@map("receipts")
}

model SecurityDeposit {
  id             String               @id @default(uuid())
  organizationId String
  tenancyId      String               @unique
  requiredAmount Decimal              @db.Decimal(12, 2)
  amountPaid     Decimal              @default(0) @db.Decimal(12, 2)
  amountDeducted Decimal              @default(0) @db.Decimal(12, 2)
  amountRefunded Decimal              @default(0) @db.Decimal(12, 2)
  status         DepositStatus        @default(PENDING)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  transactions   DepositTransaction[]
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tenancy        Tenancy              @relation(fields: [tenancyId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@map("security_deposits")
}

model DepositTransaction {
  id                 String                 @id @default(uuid())
  depositId          String
  type               DepositTransactionType
  amount             Decimal                @db.Decimal(12, 2)
  reason             String?
  authorizedByUserId String?
  manualReference    String?
  transactionDate    DateTime               @default(now())
  createdAt          DateTime               @default(now())
  deposit            SecurityDeposit        @relation(fields: [depositId], references: [id], onDelete: Cascade)

  @@index([depositId])
  @@map("deposit_transactions")
}

model Notification {
  id              String                    @id @default(uuid())
  organizationId  String?
  recipientUserId String
  type            NotificationType
  title           String
  body            String
  data            Json?
  readAt          DateTime?
  createdAt       DateTime                  @default(now())
  deliveryLogs    NotificationDeliveryLog[]

  @@index([recipientUserId, readAt])
  @@index([organizationId, createdAt])
  @@map("notifications")
}

model NotificationDeliveryLog {
  id                String              @id @default(uuid())
  notificationId    String
  channel           NotificationChannel
  status            DeliveryStatus
  providerMessageId String?
  errorMessage      String?
  attemptedAt       DateTime            @default(now())
  notification      Notification        @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@map("notification_delivery_logs")
}

model NotificationPreference {
  id           String               @id @default(uuid())
  userId       String
  category     NotificationCategory
  inAppEnabled Boolean              @default(true)
  emailEnabled Boolean              @default(true)
  smsEnabled   Boolean              @default(true)
  updatedAt    DateTime             @updatedAt
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@map("notification_preferences")
}

model Conversation {
  id             String                  @id @default(uuid())
  organizationId String
  tenantUserId   String
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  readStates     ConversationReadState[]
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tenantUser     User                    @relation(fields: [tenantUserId], references: [id], onDelete: Cascade)
  messages       Message[]

  @@unique([organizationId, tenantUserId])
  @@index([organizationId, updatedAt])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderUserId   String
  body           String
  attachmentUrl  String?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model ConversationReadState {
  id             String       @id @default(uuid())
  conversationId String
  userId         String
  lastReadAt     DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@map("conversation_read_states")
}

